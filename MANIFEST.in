include LICENSE README.md CHANGELOG.md CONTRIBUTING.md
recursive-include docs *.md
recursive-include examples *.q3
recursive-include examples *.json
recursive-include tests *.py
recursive-include tools *.py
recursive-include benchmarks *.md
recursive-include benchmarks *.json
recursive-include .github/workflows *.yml
prune build
prune dist
prune sdist
recursive-include web *.html *.css *.js
recursive-include deployment *.py *.md *.json
include render.yaml
recursive-include docs/contracts *.json
recursive-include integration/sites *.ts *.mjs *.json *.md *.sh
