              },
              "minItems": 1,
              "maxItems": 4096
            },
            "physical_basis_indices": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "uniqueItems": true,
              "minItems": 2,
              "maxItems": 65536
            }
          },
          "required": [
            "schema",
            "schema_version",
            "kind",
            "logical_dimensions",
            "physical_dimensions",
            "physical_basis_indices"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "logical_source",
        "physical_source",
        "encoding"
      ],
      "additionalProperties": false
    },
    "compareRequest": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/health"
    },
    {
      "$ref": "#/$defs/capabilities"
